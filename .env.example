# Copy to .env and fill in. .env is git-ignored: never commit real keys.
# Real environment variables override anything in .env.

# ---- Model --------------------------------------------------------------------------------
# bedrock (the submission) | anthropic | none (harness, scanner and planted candidates only)
FLAKEPROOF_PROVIDER=bedrock
FLAKEPROOF_MODEL_ID=us.amazon.nova-2-lite-v1:0
AWS_REGION=us-east-1
# Either a Bedrock API key (botocore reads this variable) or your normal AWS credentials.
# AWS_BEARER_TOKEN_BEDROCK=

# ---- GitHub (only needed to open real pull requests) -------------------------------------
# Fine-grained token scoped to your fork of the target repo, with
# Contents: Read and write, and Pull requests: Read and write.
# GITHUB_TOKEN=
# FLAKEPROOF_GITHUB_OWNER=your-github-username

# ---- Java toolchain for the target project (marine-api builds on JDK 11) -----------------
# FLAKEPROOF_JAVA_HOME=C:\Program Files\Java\jdk-11
# FLAKEPROOF_MVN=C:/tools/apache-maven-3.9.16/bin/mvn.cmd

# ---- Optional ------------------------------------------------------------------------------
# FLAKEPROOF_RERUNS=200
# FLAKEPROOF_BASELINE=20
# FLAKEPROOF_BANDAID_THRESHOLD=0.7
# FLAKEPROOF_DB=data/runs.db
# FLAKEPROOF_MVN_TIMEOUT=600
